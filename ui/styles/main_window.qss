/* 顶部状态栏与业务页面使用同一块连续背景。 */
QWidget#mainTitleBar {
    background: @background;
    border: none;
    border-bottom: none;
}
QWidget#windowStatusArea {
    background: transparent;
    border: none;
}
#mainStackedWidget {
    background: @background;
    border: none;
    border-radius: 0;
}

/* 设置固定导航的浅灰背景。 */
NavigationPanel[menu=false] {
    background: @navigation_background;
    border: none;
    border-right: 1px solid @border;
    border-radius: 0;
}
NavigationPanel QScrollArea,
NavigationPanel #scrollWidget {
    background: transparent;
    border: none;
}

/* 设置业务页面的浅色背景。 */
QWidget#realtime {
    background: @background;
}
QWidget#history, QWidget#abnormal_events,
QWidget#machines, QWidget#images, QWidget#settings, QWidget#logs {
    background: @background;
}
QScrollArea#machineScrollArea {
    background: transparent;
    border: none;
}
QScrollArea#detailScrollArea, QWidget#detailScrollViewport {
    background: transparent;
    border: none;
}
QWidget#machineScrollViewport {
    background: transparent;
}
QWidget#monitorContent {
    background: transparent;
}
QWidget#machineFields, QWidget#historyDetailBody,
QWidget#abnormalDetailBody {
    background: @white;
}

/* 显示窗口和机器的业务状态。 */
QLabel#windowStatusDot {
    background: @normal;
    border-radius: 4px;
}
QLabel#windowStatusDot[status="warning"] { background: @warning; }
QLabel#windowStatusDot[status="error"] { background: @error; }
QLabel#windowStatusDot[status="disconnected"] { background: @secondary; }
QLabel#machineBadge {
    background: #EAF1FF;
    color: @blue;
    border-radius: 12px;
    padding: 3px 8px;
    font-weight: normal;
}
QLabel#machineBadge[tone="running"] {
    background: #E4F7EC;
    color: #138B3F;
}
QLabel#machineBadge[tone="waiting"] {
    background: #FFF1DD;
    color: #A76200;
}
QLabel#machineStatus {
    background: #EEF2F7;
    color: #60748E;
    border-radius: 14px;
}
QLabel#machineStatus[enabledStatus="true"] {
    background: #E4F7EC;
    color: #138B3F;
}

/* 分隔机器卡片内的动画、读数和结果。 */
QFrame#cardDivider {
    background: @border;
    border: none;
    max-height: 1px;
}
QLabel#ocrResult {
    color: @text;
    font-size: 13px;
}
QLabel[smallText="true"] {
    color: @muted;
    font-size: 11px;
}
QWidget#beltAnimation {
    background: transparent;
    border: none;
}

/* 设置遮罩弹窗的中心内容。 */
QFrame#machineEditorContent, QFrame#historyDetailContent,
QFrame#abnormalEventDetailContent, QFrame#historyEvidencePreviewContent {
    background: @white;
    border: 1px solid @border;
    border-radius: 12px;
}

/* 设置实时总览、设备卡片和详情的白色表面。 */
QWidget#summaryCard, QWidget#machineCard {
    background: @white;
    border: 1px solid @border;
    border-radius: 12px;
}
QWidget#machineDetailPanel {
    background: @white;
    border: 1px solid @border;
    border-radius: 14px;
}
QWidget#machineCard[selected="true"] {
    border: 1px solid @blue;
}
QLabel#machineTitle {
    color: @text;
    font-size: 17px;
    font-weight: 600;
}
QLabel#summaryValue {
    color: @text;
    font-size: 28px;
    font-weight: 600;
}
QLabel#frequencyValue {
    color: @text;
    font-size: 24px;
    font-weight: bold;
}
QLabel#machineBadge[tone="error"] {
    background: #FDE8E8;
    color: #B42318;
}
QLabel#detailMachineName {
    color: @text;
    font-size: 18px;
    font-weight: 600;
}
QLabel#detailSectionLabel, QLabel#detailMetaKey, QLabel#detailCardTitle {
    color: @muted;
    font-size: 12px;
    font-weight: 500;
}
QLabel#detailMetaValue {
    color: @text;
    font-size: 14px;
    font-weight: 500;
}
QWidget#machineDetailPanel QLabel#machineBadge[tone="idle"] {
    background: #EDF2F7;
    color: #60748E;
}
QFrame#detailFrequencyCard {
    background: #F7F9FC;
    border: none;
    border-radius: 12px;
}
QLabel#detailFrequencyValue {
    color: @text;
    font-size: 30px;
    font-weight: 600;
}
QFrame#detailOcrCard {
    background: @white;
    border: 1px solid #EEF1F5;
    border-radius: 12px;
}
QFrame#detailStatsBar, QFrame#detailStatItem {
    background: transparent;
    border: none;
}
QLabel#detailStatTitle {
    color: @muted;
    font-size: 10px;
}
QLabel#detailStatValue {
    color: @text;
    font-size: 16px;
    font-weight: 600;
}
QFrame#detailStatDivider {
    background: @border;
    border: none;
}

/* 设置 OCR 摘要和详情信息卡。 */
QFrame#ocrSummaryPanel {
    background: @background;
    border: none;
    border-radius: 8px;
    color: @text;
}
QFrame#detailOcrPanel {
    background: #F5F6F8;
    border: none;
    border-radius: 10px;
}
QPlainTextEdit#detailOcrText {
    background: transparent;
    border: none;
    color: @text;
    font-size: 13px;
}
QWidget#realtime CaptionLabel { color: @muted; }

/* 设置机器列表分区的标题与辅助说明。 */
QLabel#machineSectionTitle {
    color: @text;
    font-size: 16px;
    font-weight: 600;
}
QLabel#machineSectionDescription {
    color: @muted;
    font-size: 11px;
    font-weight: 400;
}
