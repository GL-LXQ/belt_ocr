/* 顶部状态栏与业务页面使用同一块连续背景。 */
QWidget#mainTitleBar {
    background: @background;
    border: none;
    border-bottom: none;
}
QWidget#windowStatusArea {
    background: transparent;
    border: none;
}
#mainStackedWidget {
    background: @background;
    border: none;
    border-radius: 0;
}

/* 设置固定导航的浅灰背景。 */
NavigationPanel[menu=false] {
    background: @navigation_background;
    border: none;
    border-right: 1px solid @border;
    border-radius: 0;
}
NavigationPanel QScrollArea,
NavigationPanel #scrollWidget {
    background: transparent;
    border: none;
}

/* 设置业务页面的浅色背景。 */
QWidget#realtime {
    background: @background;
}
QWidget#history, QWidget#abnormal_events,
QWidget#machines, QWidget#images, QWidget#settings, QWidget#logs {
    background: @background;
}
QScrollArea#machineScrollArea {
    background: transparent;
    border: none;
}
QScrollArea#detailScrollArea, QWidget#detailScrollViewport {
    background: transparent;
    border: none;
}
QWidget#machineScrollViewport {
    background: transparent;
}
QWidget#monitorContent {
    background: transparent;
}
QWidget#machineFields, QWidget#historyDetailBody,
QWidget#abnormalDetailBody {
    background: @white;
}

/* 显示窗口和机器的业务状态。 */
QLabel#windowStatusDot {
    background: @normal;
    border-radius: 4px;
}
QLabel#windowStatusDot[status="warning"] { background: @warning; }
QLabel#windowStatusDot[status="error"] { background: @error; }
QLabel#windowStatusDot[status="disconnected"] { background: @secondary; }
QLabel#machineBadge {
    background: #EAF1FF;
    color: @blue;
    border-radius: 12px;
    padding: 3px 8px;
    font-weight: normal;
}
QLabel#machineBadge[tone="running"] {
    background: #E4F7EC;
    color: #138B3F;
}
QLabel#machineBadge[tone="waiting"] {
    background: #FFF1DD;
    color: #A76200;
}

/* 显示机器卡片的轻量相机连接状态。 */
QLabel#cameraStatusDot {
    background: @secondary;
    border: none;
    border-radius: 3px;
}
QLabel#cameraStatusDot[tone="normal"] {
    background: @normal;
}
QLabel#cameraStatusDot[tone="waiting"] {
    background: @warning;
}
QLabel#cameraStatusDot[tone="error"] {
    background: @error;
}
QLabel#cameraStatusDot[tone="idle"] {
    background: @secondary;
}
QLabel#cameraStatusText {
    color: @muted;
    font-size: 11px;
    font-weight: 400;
}
QLabel#machineStatus {
    background: #EEF2F7;
    color: #60748E;
    border-radius: 14px;
}
QLabel#machineStatus[enabledStatus="true"] {
    background: #E4F7EC;
    color: #138B3F;
}

/* 分隔机器卡片内的动画、读数和结果。 */
QFrame#cardDivider {
    background: @border;
    border: none;
    max-height: 1px;
}
QLabel#ocrResult {
    color: @text;
    font-size: 13px;
}
QLabel[smallText="true"] {
    color: @muted;
    font-size: 11px;
}
QWidget#beltAnimation {
    background: transparent;
    border: none;
}

/* 设置遮罩弹窗的中心内容。 */
QFrame#machineEditorContent, QFrame#historyDetailContent,
QFrame#abnormalEventDetailContent, QFrame#historyEvidencePreviewContent {
    background: @white;
    border: 1px solid @border;
    border-radius: 12px;
}

/* 设置实时总览、设备卡片和详情的白色表面。 */
QWidget#summaryCard, QWidget#machineCard {
    background: @white;
    border: 1px solid @border;
    border-radius: 12px;
}
QWidget#machineDetailPanel {
    background: @white;
    border: 1px solid @border;
    border-radius: 14px;
}
QWidget#machineCard[selected="true"] {
    border: 1px solid @blue;
}
QLabel#machineTitle {
    color: @text;
    font-size: 17px;
    font-weight: 600;
}
QLabel#summaryValue {
    color: @text;
    font-size: 28px;
    font-weight: 600;
}
QLabel#frequencyValue {
    color: @text;
    font-size: 24px;
    font-weight: bold;
}
QLabel#machineBadge[tone="error"] {
    background: #FDE8E8;
    color: #B42318;
}
QWidget#machineCard QLabel#machineBadge[tone="idle"] {
    background: #EEF2F7;
    color: #60748E;
}
QLabel#detailMachineName {
    color: @text;
    font-size: 18px;
    font-weight: 600;
}
QLabel#detailSectionLabel, QLabel#detailMetaKey, QLabel#detailCardTitle {
    color: @muted;
    font-size: 12px;
    font-weight: 500;
}
QLabel#detailMetaValue {
    color: @text;
    font-size: 14px;
    font-weight: 500;
}
QWidget#machineDetailPanel QLabel#machineBadge[tone="idle"] {
    background: #EDF2F7;
    color: #60748E;
}
QFrame#detailFrequencyCard {
    background: #F7F9FC;
    border: none;
    border-radius: 10px;
}
QLabel#detailFrequencyValue {
    color: @text;
    font-size: 30px;
    font-weight: 600;
}
QFrame#detailOcrCard {
    background: transparent;
    border: none;
}
QFrame#detailStatsBar {
    background: #F7F9FC;
    border: none;
    border-radius: 10px;
}
QFrame#detailStatItem {
    background: transparent;
    border: none;
}
QLabel#detailStatTitle {
    color: @muted;
    font-size: 11px;
    font-weight: 400;
}
QLabel#detailStatValue {
    color: @text;
    font-size: 16px;
    font-weight: 600;
}
QFrame#detailStatDivider {
    background: @border;
    border: none;
}

/* 设置 OCR 摘要和详情信息卡。 */
QFrame#ocrSummaryPanel {
    background: @background;
    border: none;
    border-radius: 8px;
    color: @text;
}
QFrame#detailOcrPanel {
    background: #F7F9FC;
    border: none;
    border-radius: 10px;
}
QPlainTextEdit#detailOcrText {
    background: transparent;
    border: none;
    color: @text;
    font-size: 13px;
}
QWidget#realtime CaptionLabel { color: @muted; }

/* 设置机器列表分区的标题与辅助说明。 */
QLabel#machineSectionTitle {
    color: @text;
    font-size: 16px;
    font-weight: 600;
}
QLabel#machineSectionDescription {
    color: @muted;
    font-size: 11px;
    font-weight: 400;
}

/* 设置历史筛选区和记录表格的白色表面。 */
QWidget#historyFilterCard, QWidget#historyRecordsCard {
    background: @white;
    border: 1px solid @border;
    border-radius: 12px;
}
QWidget#historyDateRange, QWidget#historyStatusWrapper {
    background: transparent;
    border: none;
}
QTableWidget#historyTable {
    background: @white;
    border: none;
    color: @text;
    gridline-color: transparent;
}
QTableWidget#historyTable QHeaderView::section {
    background: #F8FAFC;
    color: @muted;
    border: none;
    border-bottom: 1px solid @border;
    font-weight: 500;
    padding-left: 8px;
}
QTableWidget#historyTable::item:selected {
    background: #F2F6FC;
    color: @text;
}
QPushButton#historyViewButton {
    background: transparent;
    border: none;
    color: @muted;
}
QPushButton#historyViewButton:hover {
    color: @blue;
}

/* 显示历史列表和详情共用的状态徽标。 */
QLabel#historyStatusBadge, QLabel#historyDetailStatusBadge {
    border: none;
    border-radius: 11px;
    padding: 3px 9px;
    font-size: 12px;
    font-weight: 500;
}
QLabel#historyStatusBadge[tone="normal"],
QLabel#historyDetailStatusBadge[tone="normal"] {
    background: #DCF8E9;
    color: #138B3F;
}
QLabel#historyStatusBadge[tone="pending"],
QLabel#historyDetailStatusBadge[tone="pending"] {
    background: #FFF0D8;
    color: #B96600;
}
QLabel#historyStatusBadge[tone="reviewed"],
QLabel#historyDetailStatusBadge[tone="reviewed"] {
    background: #E2EEFF;
    color: #2462A8;
}

/* 将历史详情的业务结果放在浅灰信息区。 */
QScrollArea#historyDetailScroll, QScrollArea#historyEvidenceScroll {
    background: transparent;
    border: none;
}
QLabel#historyDetailMachineName {
    color: @text;
    font-size: 20px;
    font-weight: 600;
}
QLabel#historyDetailFinishedAt {
    color: @muted;
    font-size: 12px;
}
QFrame#historyDetailFrequencyCard {
    background: #F7F9FC;
    border: none;
    border-radius: 10px;
}
QLabel#historyDetailFrequencyValue {
    color: @text;
    font-size: 28px;
    font-weight: 600;
}
QFrame#historyDetailOcrPanel {
    background: #F5F6F8;
    border: none;
    border-radius: 10px;
}
QPlainTextEdit#historyDetailOcrText,
QPlainTextEdit#historyDetailOcrText:hover,
QPlainTextEdit#historyDetailOcrText:focus {
    background: transparent;
    border: none;
    color: @text;
    font-size: 13px;
}
QPlainTextEdit#historyFinalResultText {
    background: #F5F6F8;
    border: none;
    border-radius: 10px;
    color: @text;
    font-size: 13px;
}

/* 在历史详情底部显示次级记录信息。 */
QFrame#historyRecordMetaCard {
    background: #F7F9FC;
    border: none;
    border-radius: 10px;
}
QLabel#historyRecordMetaKey {
    color: @muted;
    font-size: 12px;
}
QLabel#historyRecordMetaValue {
    color: #344054;
    font-size: 12px;
}
