/* 设置业务页面的浅色背景。 */
QWidget#realtime, QWidget#history, QWidget#abnormal_events,
QWidget#machines, QWidget#images, QWidget#settings, QWidget#logs {
    background: @background;
}
QWidget#monitorContent {
    background: transparent;
}
QWidget#machineFields, QWidget#historyDetailBody,
QWidget#abnormalDetailBody {
    background: @white;
}

/* 显示窗口和机器的业务状态。 */
QLabel#windowStatusDot {
    background: @normal;
    border-radius: 4px;
}
QLabel#windowStatusDot[status="warning"] { background: @warning; }
QLabel#windowStatusDot[status="error"] { background: @error; }
QLabel#windowStatusDot[status="disconnected"] { background: @secondary; }
QLabel#machineBadge {
    background: #EAF1FF;
    color: @blue;
    border-radius: 12px;
    padding: 4px 10px;
}
QLabel#machineBadge[tone="running"] {
    background: #E4F7EC;
    color: #138B3F;
}
QLabel#machineBadge[tone="waiting"] {
    background: #FFF1DD;
    color: #A76200;
}
QLabel#machineStatus {
    background: #EEF2F7;
    color: #60748E;
    border-radius: 14px;
}
QLabel#machineStatus[enabledStatus="true"] {
    background: #E4F7EC;
    color: #138B3F;
}

/* 分隔机器卡片内的动画、读数和结果。 */
QFrame#cardDivider {
    background: @border;
    border: none;
    max-height: 1px;
}
QLabel#ocrResult {
    color: @text;
    font-size: 13px;
}
QLabel[smallText="true"] {
    color: @muted;
    font-size: 11px;
}
QWidget#beltAnimation {
    background: #EFF3F8;
    border: 1px solid @border;
    border-radius: 6px;
}

/* 设置三个遮罩弹窗的中心内容。 */
QFrame#machineEditorContent, QFrame#historyDetailContent,
QFrame#abnormalEventDetailContent {
    background: @white;
    border: 1px solid @border;
    border-radius: 12px;
}
