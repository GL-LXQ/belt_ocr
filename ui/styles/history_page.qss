/* 设置历史页标题和轻量说明。 */
QWidget#history QLabel#pageTitle {
    color: #20232B;
    font-size: 28px;
    font-weight: 600;
}
QWidget#history QLabel#pageSubtitle {
    color: #81858F;
    font-size: 13px;
    font-weight: 400;
}

/* 设置历史查询区和记录表格的白色表面。 */
QWidget#historyFilterCard, QWidget#historyRecordsCard {
    background: @white;
    border: 1px solid #E5E7EB;
    border-radius: 16px;
}
QWidget#historyStatusFilter {
    background: #F1F2F5;
    border: none;
    border-radius: 9px;
}
QWidget#historyStatusFilter QPushButton {
    color: #747985;
    font-size: 13px;
}
QWidget#historyStatusFilter QPushButton[isSelected=true] {
    color: #222733;
    font-weight: 500;
}
QLabel#historyRecordCount {
    color: #8B909A;
    font-size: 12px;
}
QLabel#historyPageNumber {
    color: #747985;
    font-size: 12px;
}
QLineEdit#historyTextQuery {
    background: #F5F6F8;
    border: 1px solid #F0F1F4;
    border-radius: 10px;
    color: #252B35;
    font-size: 14px;
    padding: 0 12px;
}
QLineEdit#historyTextQuery:hover {
    background: #F1F3F7;
}
QLineEdit#historyTextQuery:focus {
    background: #FFFFFF;
    border: 1px solid #8AB5FF;
}
QPushButton#historyMatchMode, QPushButton#historyTextLength {
    background: #F7F8FA;
    border: 1px solid #EAECF0;
    border-radius: 10px;
    color: #505765;
    font-size: 13px;
    padding-left: 14px;
}
QPushButton#historyMatchMode:hover, QPushButton#historyTextLength:hover {
    background: #EFF2F7;
}
QPushButton#historySearchButton {
    background: #3478F6;
    border: 1px solid #3478F6;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#historySearchButton:hover {
    background: #286BE8;
}
QPushButton#historySearchButton:pressed {
    background: #205BCC;
}
QPushButton#historyResetFiltersButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    color: #818795;
    font-size: 13px;
}
QPushButton#historyResetFiltersButton:hover {
    background: #F3F5F8;
    color: #424A59;
}
/* 在第二行显示轻量筛选入口和已应用条件。 */
QPushButton#historyMachineFilter, QPushButton#historyTimeFilter {
    background: #F7F8FA;
    border: 1px solid #EAECF0;
    border-radius: 9px;
    color: #667080;
    font-size: 12px;
    padding: 0 10px;
}
QPushButton#historyMachineFilter:hover, QPushButton#historyTimeFilter:hover {
    background: #EFF2F7;
}
QPushButton#historyMachineFilter[active=true], QPushButton#historyTimeFilter[active=true] {
    background: #F0F5FF;
    border-color: #DAE7FF;
    color: #3478F6;
}
QWidget#historyDateRange, QWidget#historyStatusWrapper {
    background: transparent;
    border: none;
}
QTableWidget#historyTable {
    background: @white;
    border: none;
    color: @text;
    gridline-color: transparent;
}
QTableWidget#historyTable QHeaderView::section {
    background: #FAFAFC;
    color: #8B909A;
    border: none;
    border-bottom: 1px solid @border;
    font-weight: 500;
    font-size: 12px;
    padding-left: 8px;
}
QTableWidget#historyTable::item:selected {
    background: #F2F6FC;
    color: @text;
}
QPushButton#historyViewButton {
    background: transparent;
    border: none;
    color: #4F7FC8;
    font-size: 13px;
}
QPushButton#historyViewButton:hover {
    color: @blue;
}
